#!name=yhei_Locket_Local
#!desc=Locket Gold Local Hot Reload Test
#!url=http://192.168.80.129:8080/modules/yhei_Locket_Local.sgmodule

[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=http://192.168.80.129:8080/js/Locket_Gold.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=http://192.168.80.129:8080/js/deleteHeader.js, timeout=60

locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=http://192.168.80.129:8080/js/Locket_Unlocked.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
