							<string>NeverConnect</string>
							<key>Domains</key>
							<array>
								<string>3gppnetwork.org</string>
							</array>
						</dict>
					</array>
				</dict>
			</array>
			<key>PayloadDisplayName</key>
			<string>Locket Gold DNS</string>
			<key>PayloadIdentifier</key>
			<string>com.yheiakadylan.dns.8vkc90uh</string>
			<key>PayloadType</key>
			<string>com.apple.dnsSettings.managed</string>
			<key>PayloadUUID</key>
			<string>B5E3B4A0-1234-4F5A-8B6C-38766b633930</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Hồ sơ cấu hình VIP chặn thu hồi Locket Gold vĩnh viễn. @yheiakadylan</string>
